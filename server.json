{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Edge-Echo/mcp-netassist",
  "description": "Windows network and proxy diagnostics: GitHub reachability, proxy ports, DNS/TCP, and fixes.",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-netassist",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "value": "-y",
          "type": "positional"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Edge-Echo/mcp-netassist",
    "source": "github"
  }
}
